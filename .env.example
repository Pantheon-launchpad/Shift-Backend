DATABASE_URL="postgresql://user:password@localhost:5432/shift"
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_PEPPER="change_me"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# AI service (src/services/ai) — NVIDIA is the primary provider, Anthropic
# is the fallback. Leave either key unset to disable that provider; leave
# both unset and every capability degrades to its deterministic fallback
# (see each file in src/services/ai/capabilities/).
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1.5"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
# How often (ms) to ping a downed NVIDIA in the background to auto-recover.
AI_NVIDIA_HEALTH_CHECK_INTERVAL_MS=30000

# OAuth (leave a provider's id/secret unset to keep it disabled — 501)
OAUTH_REDIRECT_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
# Deep link scheme the React Native app registers for OAuth callbacks
# (e.g. in app.json's "scheme" field). Used when /auth/oauth/:provider/start
# is called with ?platform=native instead of the default web flow.
NATIVE_APP_SCHEME="shift://auth-callback"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FIGMA_CLIENT_ID=""
FIGMA_CLIENT_SECRET=""
